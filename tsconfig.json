{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node"], "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "scripts/**/*.ts", "vite.config.ts"]
}
