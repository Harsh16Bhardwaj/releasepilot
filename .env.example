# No credentials are required to read a public repository at the anonymous rate limit.
GITHUB_TOKEN=
# Dedicated disposable Flagsmith environment; never point the probe at production.
FLAGSMITH_MANAGEMENT_URL=https://api.flagsmith.com/api/v1/
FLAGSMITH_SDK_URL=https://edge.api.flagsmith.com/api/v1/
# 15s polling is about 23040 configuration reads over four days for one running app.
FLAGSMITH_REFRESH_SECONDS=15
# Organisation API keys use Api-Key; existing user API tokens use Token.
FLAGSMITH_AUTH_SCHEME=Api-Key
FLAGSMITH_API_KEY=
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_SDK_KEY=
FLAGSMITH_PROJECT_ID=
# Precreate one feature-specific segment with a single PERCENTAGE_SPLIT condition.
# Its enabled override must target the otherwise-disabled probe feature below.
FLAGSMITH_PROBE_SEGMENT_ID=
FLAGSMITH_PROBE_FLAG=releasepilot_probe
# Required explicit acknowledgement for the write probe.
FLAGSMITH_PROBE_DISPOSABLE=false
CODEX_BIN=codex
CODEX_TIMEOUT_SECONDS=180
# Future sprint connections; doctor reports these separately from Sprint 1.
BITE_DEPLOYMENT_URL=
METRICS_URL=
# Optional local website port (default 3100).
BITE_PORT=3100
TRAFFIC_PORT=3200
